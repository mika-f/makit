{
  "name": "@natsuneko-laboratory/makit-theme-brutalist",
  "version": "0.6.1",
  "description": "A bold Makit theme with heavy rules, offset shadows, and high-contrast color.",
  "license": "MIT",
  "repository": "https://github.com/mika-f/makit.git",
  "files": [
    "dist",
    "styles"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./makit-theme": {
      "types": "./dist/manifest.d.mts",
      "import": "./dist/manifest.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@natsuneko-laboratory/makit": "workspace:*",
    "@natsuneko-laboratory/makit-runtime": "workspace:*",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsdown": "^0.22.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@natsuneko-laboratory/makit": "^0.4.0",
    "@natsuneko-laboratory/makit-runtime": "^0.4.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}